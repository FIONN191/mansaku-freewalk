{
  "name": "freewalk-helper",
  "version": "0.2.2",
  "description": "漫展自由行申请助手：三平台（小红书/抖音/QQ空间）自动发布",
  "main": "main.js",
  "author": "Fionn",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "smoke": "electron . --smoke-test",
    "dist": "electron-builder --mac --win"
  },
  "devDependencies": {
    "electron": "33.4.11",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.fionn.freewalk-helper",
    "productName": "漫展自由行助手",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "main-impl.js",
      "preload.js",
      "drivers/**",
      "ui/**",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "universal"
          ]
        }
      ],
      "artifactName": "Freewalk-Helper-${version}-mac.${ext}",
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "Freewalk-Helper-Setup-${version}-win-x64.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
